/// Scenarios (Actual, Budget, Forecast). Hidden; filters Plan only. The measures Actual, Budget and Forecast pick the scenario.
table Scenario
	isHidden

	column 'Scenario Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		isKey
		summarizeBy: none
		sourceColumn: Scenario Key

	column 'Scenario Name'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Scenario Name

	partition Scenario = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Dim_Scenario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ScenarioKey", Int64.Type}, {"ScenarioName", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"ScenarioKey", "Scenario Key"}, {"ScenarioName", "Scenario Name"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

